{
  "name": "ayeverse-docs",
  "private": true,
  "type": "module",
  "description": "Ayeverse / 8b.is documentation site \u2014 Astro Starlight over the papers in this repo.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs && node scripts/sync-library.mjs",
    "dev": "npm run sync && astro dev --host 127.0.0.1 --port 4321",
    "build": "npm run sync && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "astro-mermaid": "^2.1.0",
    "katex": "^0.16.22",
    "mermaid": "^11.9.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "@astrojs/markdown-remark": "^7.3.0",
    "@mermaid-js/layout-elk": "^0.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
